{
  "buildCommand": "pnpm run typecheck && pnpm --filter @workspace/portfolio build && pnpm --filter @workspace/api-server build",
  "outputDirectory": "artifacts/portfolio/dist/public",
  "installCommand": "pnpm install",
  "devCommand": "pnpm --filter @workspace/portfolio run dev -- --port $PORT",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/((?!api/|@|src/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/" }
  ]
}