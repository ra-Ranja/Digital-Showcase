{
  "buildCommand": "pnpm --filter @workspace/api-server build && pnpm run typecheck && pnpm --filter @workspace/portfolio build",
  "outputDirectory": "artifacts/portfolio/dist/public",
  "installCommand": "pnpm install",
  "devCommand": "pnpm --filter @workspace/portfolio run dev -- --port $PORT",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...slug]" },
    { "source": "/((?!api/|@|src/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/" }
  ]
}